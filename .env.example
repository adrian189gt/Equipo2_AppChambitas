# Copia este archivo a .env y llena los valores.
# Las variables EXPO_PUBLIC_ quedan embebidas en la app: aqui SOLO va
# informacion que puede ser publica.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Login con Google: Google Cloud > Credenciales > ID de cliente OAuth
# tipo "Aplicacion web". El ID de cliente NO es secreto.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# La llave de Anthropic NO va aqui ni en ningun archivo de la app.
# Vive solo en el servidor:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
