{
  "expo": {
    "name": "Chambitas",
    "slug": "chambitasmx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.chambitas.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mx.chambitas.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chambitas usa tu ubicación para mostrarte trabajadores cerca de ti."
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "scheme": "chambitas",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01de4817-7325-4c8e-acd4-e56c3e89d46e"
      }
    },
    "owner": "andres07s-team"
  }
}
